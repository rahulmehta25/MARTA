# MARTA Backend Environment Variables

# Application
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Database - Using SQLite for local development
DATABASE_URL=sqlite:///./marta_data.db
DB_PASSWORD=dummy  # Required by settings but not used for SQLite

# Redis (optional for development)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# MARTA API
MARTA_API_KEY=ff98ada7-0436-42c5-b9bf-1071245ad1a0
MARTA_GTFS_URL=https://itsmarta.com/google_transit.zip

# Security
SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Feature Flags
ENABLE_REAL_TIME_UPDATES=False
ENABLE_ML_PREDICTIONS=False
ENABLE_CACHING=False
CACHE_TTL_SECONDS=300

# Data Ingestion
GTFS_UPDATE_SCHEDULE=0 3 * * *
REAL_TIME_POLL_INTERVAL=30
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=5