# MARTA Transit API Configuration
# Copy this file to .env and update values for your environment

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME="MARTA Transit API"
APP_VERSION="1.0.0"
ENVIRONMENT=development  # development, staging, production
DEBUG=false

# =============================================================================
# API Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
API_TITLE="MARTA Transit Analytics API"
API_DESCRIPTION="Production-grade API for transit demand forecasting and route optimization"

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
# Local dev against the shared portfolio Cloud SQL instance:
#   1. Run scripts/db-proxy.sh in another terminal (brew install cloud-sql-proxy).
#   2. Pull password: gcloud secrets versions access latest \
#        --secret=portfolio-pg-postgres-password --project=osmoti-auth
#   3. Replace CHANGEME with that password below.
DATABASE_URL=postgresql://postgres:CHANGEME@127.0.0.1:5432/marta?sslmode=disable

# Legacy field-level config (kept for compatibility if DATABASE_URL is unset).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marta
DB_USER=postgres
DB_PASSWORD=CHANGEME
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# =============================================================================
# Redis (Optional - for distributed caching)
# =============================================================================
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# =============================================================================
# Security
# =============================================================================
# IMPORTANT: Generate a secure key for production:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production-use-a-secure-random-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7
API_KEY_HEADER=X-API-Key
# Comma-separated list of valid API keys
ALLOWED_API_KEYS=marta_dev_key_12345,marta_prod_key_67890

# =============================================================================
# CORS (Cross-Origin Resource Sharing)
# =============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100       # Requests per window
RATE_LIMIT_WINDOW_SECONDS=60  # Window duration
RATE_LIMIT_BURST=20           # Burst limit

# =============================================================================
# Caching
# =============================================================================
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300              # Default cache TTL (5 min)
CACHE_FORECAST_TTL_SECONDS=600     # Forecast cache TTL (10 min)
CACHE_REALTIME_TTL_SECONDS=30      # Real-time data cache TTL

# =============================================================================
# Pagination
# =============================================================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json or text
# LOG_FILE=/var/log/marta-api/api.log  # Optional file logging

# =============================================================================
# MARTA External APIs
# =============================================================================
MARTA_API_KEY=your_marta_api_key
MARTA_RAIL_API_KEY=your_marta_rail_api_key
MARTA_GTFS_URL=https://itsmarta.com/google_transit.zip

# =============================================================================
# ML Models
# =============================================================================
MODELS_DIR=models
ENABLE_ML_PREDICTIONS=true
MODEL_TIMEOUT_SECONDS=30

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_WEBSOCKET=true
ENABLE_REALTIME=true
ENABLE_OPTIMIZATION=true
