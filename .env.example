# Railway Environment Variables
# Copy these to Railway's environment variables section

# Application
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO

# Database - Railway will provide DATABASE_URL automatically if you add PostgreSQL
DATABASE_URL=sqlite:///./marta_data.db
DB_PASSWORD=dummy

# Security
SECRET_KEY=your-secret-key-here-change-this

# MARTA API Keys
MARTA_API_KEY=ff98ada7-0436-42c5-b9bf-1071245ad1a0
MARTA_RAIL_API_KEY=ff98ada7-0436-42c5-b9bf-1071245ad1a0

# CORS - Update with your Vercel domain
CORS_ORIGINS=["https://your-app.vercel.app","http://localhost:5173"]

# Feature Flags
ENABLE_REAL_TIME_UPDATES=True
ENABLE_ML_PREDICTIONS=False
ENABLE_CACHING=False
